// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(uuid())
  ign       String   @unique
  whatsapp  String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("Rank")
  price       Int
  discount    Int      @default(0)
  duration    String
  image       String?
  isPopular   Boolean  @default(false)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  totalAmount   Int
  paymentMethod String      @default("QRIS")
  status        String      @default("PENDING") // PENDING, PAID, CANCELLED
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int      @default(1)
  price     Int      // Snapshot price at the time of purchase
  duration  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id                   String   @id @default(uuid())
  code                 String   @unique
  discount             Int      // 1 to 100
  maxUses              Int?     // null means no limit
  usedCount            Int      @default(0)
  applicableProductIds String[] @default([]) // Array of product IDs this voucher applies to. Empty array means it applies to all.
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
